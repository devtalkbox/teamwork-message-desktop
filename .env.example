# macOS code signing
CSC_LINK=
CSC_KEY_PASSWORD=

# macOS notarization: App Store Connect API key (Option B)
# Use APPLE_API_KEY_PATH for local builds, or APPLE_API_KEY for the complete
# Base64-encoded .p8 file in CI. Never set both.
APPLE_API_KEY_PATH=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_KEY_TYPE=team
REQUIRE_NOTARIZATION=false
